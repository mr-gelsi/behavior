{
  "name": "behavior-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Behavior step tracker with P5 points, store, and Rewards Day seat booking. Runs on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply behavior-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply behavior-tracker --remote",
    "test": "node --no-warnings test/run.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
